new_tags as (
select p.id,
p.skid,
ps.style_id,
COALESCE(STRING_AGG(distinct case when pat.key='gender' then pa.value end order by case when pat.key='gender' then pa.value end),MAX(pt.gender)) as gender,
STRING_AGG(distinct a.name order by a.name) as article_type,
STRING_AGG(distinct pc.name order by pc.name) as category,
STRING_AGG(distinct d.name order by d.name) as division,
max(pb.name) as brand,
STRING_AGG(distinct case when pat.key="colors" then pa.value end) as color,
STRING_AGG(distinct case when pat.key="tops_fit" then pa.value end) as tops_fit,
STRING_AGG(distinct case when pat.key="bottoms_fit" then pa.value end) as bottoms_fit,
CONCAT(
  COALESCE(
    STRING_AGG(DISTINCT CASE WHEN pat.key = 'tops_fit' THEN pa.value END),
    ''
  ),
  CASE
    WHEN STRING_AGG(DISTINCT CASE WHEN pat.key = 'tops_fit' THEN pa.value END) IS NOT NULL
         AND STRING_AGG(DISTINCT CASE WHEN pat.key = 'bottoms_fit' THEN pa.value END) IS NOT NULL
    THEN ','
    ELSE ''
  END,
  COALESCE(
    STRING_AGG(DISTINCT CASE WHEN pat.key = 'bottoms_fit' THEN pa.value END),
    ''
  )
) AS fit,
STRING_AGG(distinct case when pat.key="material" then pa.value end) as material,
STRING_AGG(distinct case when pat.key="materials" then pa.value end) as materials,
STRING_AGG(distinct case when pat.key="sleeve_type" then pa.value end) as sleeve_type
from slikk-prod.slikkprodpublic.product_product as p
inner join slikk-prod.slikkprodpublic.product_brand pb on pb.id=p.brand_id
inner join slikk-prod.slikkprodpublic.product_style ps on p.style_ref_id = ps.id
left join slikk-prod.slikkprodpublic.product_styleattribute ps2 on ps.id = ps2.style_id
left join slikk-prod.slikkprodpublic.product_attribute pat on pat.id=ps2.attribute_id
left join slikk-prod.slikkprodpublic.product_attributevalue pa on ps2.attribute_value_id = pa.id
left join slikk-prod.slikkprodpublic.product_articletype  a on a.id=ps.article_type_id
left join slikk-prod.slikkprodpublic.product_category pc on pc.id=a.category_id
left join slikk-prod.slikkprodpublic.product_division d on pc.division_id=d.id
left join product_tags pt on pt.product_id=p.id
group by 1,2,3
),
