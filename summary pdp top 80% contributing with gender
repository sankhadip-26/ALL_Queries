WITH date_range AS (
  SELECT
    DATE '2026-07-30' AS start_date,
    DATE '2026-10-29' AS end_date
),

pdp_events AS (
  SELECT
    e.create_date,
    e.product_id AS event_product_id,
    e.product_gender
  FROM `slikk-prod.slikksilver.silver_pdp_events` e
  CROSS JOIN date_range d
  WHERE DATE(e.create_date) BETWEEN d.start_date AND d.end_date
),

product_mapping AS (
  SELECT
    pp.id AS product_id,
    pp.variant_id AS style_code,
    nt.article_type AS article_type,
    LOWER(pp.skid) AS skid_key,
    LOWER(pp.sku) AS sku_key,
    LOWER(pp.barcode) AS barcode_key
  FROM `slikk-prod.slikkprodpublic.product_product` pp
  LEFT JOIN `slikk-prod.slikkanalytics.silver_new_product_tags` nt
    ON nt.product_id = pp.id
),

matched_pdp AS (
  SELECT
    e.create_date,
    e.event_product_id,
    COALESCE(
      NULLIF(UPPER(JSON_VALUE(e.product_gender, '$')), ''),
      NULLIF(UPPER(JSON_VALUE(e.product_gender, '$[0]')), '')
    ) AS gender,
    pm.product_id,
    pm.article_type,
    pm.style_code
  FROM pdp_events e
  LEFT JOIN product_mapping pm
    ON LOWER(e.event_product_id) = pm.skid_key
    OR LOWER(e.event_product_id) = pm.sku_key
    OR LOWER(e.event_product_id) = pm.barcode_key
),

style_pdp AS (
  SELECT
    article_type,
    gender,
    style_code,
    COUNT(*) AS style_pdp_views
  FROM matched_pdp
  WHERE
    article_type IS NOT NULL
    AND gender IS NOT NULL
    AND style_code IS NOT NULL
  GROUP BY
    article_type,
    gender,
    style_code
),

ranked_styles AS (
  SELECT
    article_type,
    gender,
    style_code,
    style_pdp_views,

    SUM(style_pdp_views) OVER (
      PARTITION BY article_type, gender
    ) AS total_pdp_views,

    SUM(style_pdp_views) OVER (
      PARTITION BY article_type, gender
      ORDER BY style_pdp_views DESC, style_code
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS cumulative_pdp_views

  FROM style_pdp
),

article_summary AS (
  SELECT
    article_type,
    gender,
    MAX(total_pdp_views) AS total_pdp_views,

    MAX(total_pdp_views) * 0.80 AS pdp_target_80,

    COUNTIF(
      cumulative_pdp_views - style_pdp_views
        < total_pdp_views * 0.80
    ) AS styles_needed_for_80,

    COUNT(*) AS total_styles_viewed

  FROM ranked_styles
  GROUP BY
    article_type,
    gender
)

SELECT
  article_type,
  gender,
  total_pdp_views,
  ROUND(pdp_target_80, 2) AS pdp_target_80,
  styles_needed_for_80,
  total_styles_viewed,

  ROUND(
    SAFE_DIVIDE(
      styles_needed_for_80,
      total_styles_viewed
    ) * 100,
    2
  ) AS percent_of_styles_needed

FROM article_summary

ORDER BY
  SUM(total_pdp_views) OVER (PARTITION BY article_type) DESC,
  total_pdp_views DESC;
